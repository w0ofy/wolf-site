{
  "name": "wolf-site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint '**/*{.ts,.tsx,.js}' --fix",
    "prettify": "pretty-quick --pattern '**/*.*(js|ts|tsx)'"
